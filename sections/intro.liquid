{% if section.settings.checkbox_show_intro == true %}
<div class="doormat-animation"><div class="custom-input w-embed"></div>
<img class="cs-background-image intro" src="{{ section.settings.image_background_image | img_url: 'master' }}" alt="{{ section.settings.image_background_image.alt }}" sizes="(max-width: 3000px) 100vw, 3000px" loading="lazy">
<div class="cs-video-wrapper intro"><div class="cs-video-desktop-wrapper"><div li-object="section.settings.desktop | video_tag: autoplay: true, loop: true, muted: true, controls: false, width: '100%', height: '100%'" class="cs-video-desktop">{{ section.settings.desktop | video_tag: autoplay: true, loop: true, muted: true, controls: false, width: '100%', height: '100%' }}</div><div class="video-embed w-embed"></div>
</div><div class="cs-video-mobile-wrapper"><div li-object="section.settings.mobile | video_tag: autoplay: true, loop: true, muted: true, controls: false, width: '100%', height: '100%'" class="cs-video-mobile">{{ section.settings.mobile | video_tag: autoplay: true, loop: true, muted: true, controls: false, width: '100%', height: '100%' }}</div><div class="video-embed w-embed"></div>
</div></div></div>{% endif %}
 {% schema %} {"tag":"div","name":"Intro","settings":[{"id":"checkbox_show_intro","type":"checkbox","label":"Show Intro","default":true},{"type":"header","content":"Note","info":"Use image as a backup while video is loading."},{"id":"image_background_image","type":"image_picker","label":"Background Image"},{"type":"header","content":"desktop"},{"type":"video","id":"desktop","label":"Desktop Video"},{"type":"header","content":"mobile"},{"type":"video","id":"mobile","label":"Mobile Video"}],"presets":[{"name":"Intro","category":"Liquify","blocks":[]}]} {% endschema %}