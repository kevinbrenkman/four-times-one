  const signupBtn = document.querySelector('.newsletter-signup-btn');
  signupBtn.classList.add('open');
  // Add the .open class to .newsletter-form-input after 0.5 seconds
  setTimeout(() => {
    const formInput = document.querySelector('.newsletter-form-input');
    formInput.classList.add('open');
  }, 500); // 500 milliseconds = 0.5 seconds
});
</script><script src="https://unpkg.com/@studio-freight/lenis@1.0.36/dist/lenis.min.js"></script><script>// LENIS SMOOTH SCROLL
let lenis;
if (Webflow.env("editor") === undefined) {
  lenis = new Lenis({
    lerp: 0.3,
    wheelMultiplier: 0.7,
    gestureOrientation: "vertical",
    normalizeWheel: false,
    smoothTouch: false
  });
  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);
}
$("[data-lenis-start]").on("click", function () {
  lenis.start();
});
$("[data-lenis-stop]").on("click", function () {
  lenis.stop();
});
$("[data-lenis-toggle]").on("click", function () {
  $(this).toggleClass("stop-scroll");
  if ($(this).hasClass("stop-scroll")) {
    lenis.stop();
  } else {
    lenis.start();
  }
});
</script><script>document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.slide-into-view');
    let options = {
      rootMargin: '0px 0px -10%', // Adjust this value to trigger the animation earlier
      threshold: 0.3 // This can also be adjusted based on how early you want the animation to start
    };
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          // Add a delay based on the index to stagger the animations
          setTimeout(() => {
            entry.target.style.opacity = 1;
            entry.target.style.transform = 'translateY(0)';
          }, index * 300); // Staggered delay
        }
      });
    }, options);
    items.forEach((item, index) => {
      observer.observe(item);
    });
  });
</script>
  
<script>
document.addEventListener('DOMContentLoaded', function () {
    let url = window.location.href;

    // If success message is in the URL, don't auto-hide it
    if (url.includes('?customer_posted=true#contact_form')) {
        console.log("Success message detected. Keeping URL intact.");
    } else {
        setTimeout(function () {
            const formWrapper = document.querySelector('.cs-form-wrapper');
            if (formWrapper) {
                formWrapper.classList.add('open');
            }
        }, 5000);
    }

    // Close signup form
    const closeSignUpButton = document.querySelector('#closeSignUp');
    if (closeSignUpButton) {
        closeSignUpButton.addEventListener('click', function () {
            document.querySelector('.cs-form-wrapper')?.classList.remove('open');
        });
    }

    // Open login section
    const openLoginButton = document.querySelector('#openLogin');
    if (openLoginButton) {
        openLoginButton.addEventListener('click', function () {
            document.querySelector('.section_under-construction')?.classList.remove('hidden');
            document.querySelector('.section_cs_signup')?.classList.add('close');
        });
    }
});
</script>
  
  <script>// Function to handle general input formatting
    function formatInput(e) {
        let input = e.target.value.trim().replace(/\s+/g, ''); // Remove spaces
        e.target.value = input.charAt(0).toUpperCase() + input.slice(1).toLowerCase(); // Capitalize first letter
    }
    // Function to handle email input formatting
    function formatEmailInput(e) {
        e.target.value = e.target.value.trim().replace(/\s+/g, ''); // Remove spaces, no capitalization
    }
    // List of IDs for general formatting
    const generalIds = ['name', 'last_name'];
    // List of IDs for email-specific formatting
    const emailIds = ['email'];
    // Add event listeners for general formatting
    generalIds.forEach(function (id) {
        document.getElementById(id).addEventListener('input', formatInput);
    });
    // Add event listeners for email-specific formatting
    emailIds.forEach(function (id) {
        document.getElementById(id).addEventListener('input', formatEmailInput);
    });
</script><script>// Function to check URL parameters and add classes on page load
document.addEventListener('DOMContentLoaded', function() {
    // Get the current URL
    const url = window.location.href;
    // Check if URL contains the specific parameter and fragment
    if (url.includes('?customer_posted=true#contact_form')) {
        // Add classes to specific elements
        const formWrapper = document.querySelector('.cs-form-wrapper');
        const formInitialState = document.querySelector('.form-initial-state');
        const formSuccessState = document.querySelector('.form-succes-state');
        if (formWrapper) {
            formWrapper.classList.add('open');
        }
        if (formInitialState) {
            formInitialState.classList.add('succes');
        }
        if (formSuccessState) {
            formSuccessState.classList.add('succes');
        }
        // Find all elements with hs-newsletter-show attribute
        const newsletterElements = document.querySelectorAll('[hs-newsletter-show]');
        // Set display to flex for each element
        newsletterElements.forEach(element => {
            element.style.display = 'flex';
        });
    }
});
</script>
