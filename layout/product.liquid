<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script><script>document.addEventListener('DOMContentLoaded', function() {
    function initializeSlider() {
      var splides = document.querySelectorAll('.productslider'); // Updated class name
      console.log('Number of slider elements found:', splides.length);
      for (var i = 0; i < splides.length; i++) {
        console.log('Initializing Splide slider', i + 1);
        // Ensure slider container is focusable, but remove the default blue outline
        splides[i].setAttribute("tabindex", "0");
        splides[i].style.outline = "none"; // Removes blue focus outline
        let splideInstance = new Splide(splides[i], {
          focus: 0, 
          type: 'loop', 
          gap: '0em', 
          arrows: 'slider', 
          pagination: false, 
          speed: 1000, 
          dragAngleThreshold: 60, 
          autoWidth: true, 
          rewind: false, 
          rewindSpeed: 400,
          autoplay: true,
          interval: 2500,
          waitForTransition: false,
          pauseOnHover: false,
          updateOnMove: true,
          trimSpace: true, 
          keyboard: true,  // Ensure keyboard navigation is enabled
          breakpoints: {
            1910: {
              perPage: 2,
              gap: '0em',
            },
            991: {
              perPage: 2,
              gap: '0em',
            },
            767: {
              perPage: 1, // Adjusts for smaller screens instead of destroying
            }
          }
        }).mount();
        // Focus the slider to enable immediate keyboard control
        splides[i].focus();
        // Ensure keyboard navigation works on focus
        splides[i].addEventListener('keydown', function(event) {
          if (event.key === 'ArrowLeft') {
            splideInstance.go('<'); // Move to previous slide
          }
          if (event.key === 'ArrowRight') {
            splideInstance.go('>'); // Move to next slide
          }
        });
        // Add wheel event listener for Apple touchpad support
        let isScrolling = false;
        const swipeThreshold = 50; 
        splides[i].addEventListener('wheel', function (event) {
          if (Math.abs(event.deltaX) > Math.abs(event.deltaY) && Math.abs(event.deltaX) > swipeThreshold) {
            event.preventDefault();
            if (!isScrolling) {
              isScrolling = true;
              if (event.deltaX > 0) {
                splideInstance.go('>'); 
              } else {
                splideInstance.go('<'); 
              }
              setTimeout(() => {
                isScrolling = false;
              }, 400);
            }
          }
        }, { passive: false });
      }
      console.log('Splide sliders initialized successfully');
    }
    // Attempt initializing the slider once after a 1-second delay
    setTimeout(initializeSlider, 1000);
  });
</script><script>document.addEventListener('DOMContentLoaded', function() {
    const productRecommendationsSection = document.querySelector('.product-recommendations');
    const url = productRecommendationsSection.dataset.url;
    fetch(url)
      .then(response => response.text())
      .then(text => {
      const html = document.createElement('div');
      html.innerHTML = text;
      const recommendations = html.querySelector('.product-recommendations');
      if (recommendations && recommendations.innerHTML.trim().length) {
        productRecommendationsSection.innerHTML = recommendations.innerHTML;
      }
    })
      .catch(e => {
      console.error(e);
    });
  });
</script>
