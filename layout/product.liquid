<script>document.querySelector('.open-signup-trigger').addEventListener('click', () => {
  // Add the .open class to .open-signup-trigger
  const trigger = document.querySelector('.open-signup-trigger');
  trigger.classList.add('open');
  // Add the .open class to .newsletter-input-field-hidden
  const hiddenInputField = document.querySelector('.newsletter-input-field-hidden');
  hiddenInputField.classList.add('open');
  // Add the .open class to .newsletter-signup-btn
  const signupBtn = document.querySelector('.newsletter-signup-btn');
  signupBtn.classList.add('open');
  // Add the .open class to .newsletter-form-input after 0.5 seconds
  setTimeout(() => {
    const formInput = document.querySelector('.newsletter-form-input');
    formInput.classList.add('open');
  }, 500); // 500 milliseconds = 0.5 seconds
});
