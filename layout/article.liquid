const swiperWrapper = document.querySelector(".swiper-wrapper");
if (!swiperWrapper) {
    console.error("Swiper wrapper not found.");
} else {
    console.log("Swiper wrapper found:", swiperWrapper);
    const updateVideoStates = () => {
        console.log("Updating video states...");
        const slides = swiperWrapper.querySelectorAll(".swiper-slide");
        slides.forEach(slide => {
            const video = slide.querySelector("video");
            if (video) {
                if (slide.classList.contains("swiper-slide-active")) {
                    console.log(`Playing video on slide with index: ${slide.getAttribute("data-swiper-slide-index")}`);
                    video.play().catch(err => console.error(`Error playing video: ${err}`));
                } else {
                    console.log(`Pausing video on slide with index: ${slide.getAttribute("data-swiper-slide-index")}`);
                    video.pause();
                }
            } else {
                console.log(`No video found on slide with index: ${slide.getAttribute("data-swiper-slide-index")}`);
            }
        });
    };
    // Run initially to set the correct states
    console.log("Initializing video state updater...");
    updateVideoStates();
    // Add an observer to detect changes to the active slide
    const observer = new MutationObserver((mutationsList) => {
        console.log("Mutation detected. Updating video states...");
        updateVideoStates();
    });
    observer.observe(swiperWrapper, { attributes: true, childList: false, subtree: true });
    console.log("Video state updater initialized and observer added.");
}
