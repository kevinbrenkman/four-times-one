</div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=66e97989bb936bc07385b5e6" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="{{ 'liquify-starter-template-1-0-f5cb72.js' | asset_url }}" type="text/javascript"></script><script>document.addEventListener('DOMContentLoaded', function() {
    // If animation has already played, stop execution early
    if (sessionStorage.getItem('animationPlayed')) return;
    // Ensure doormat-animation is visible
    document.querySelector('.doormat-animation').classList.remove('hide');
    // Add .no-scroll to <html> and <body> to prevent scrolling during animation
    document.documentElement.classList.add('no-scroll'); // Apply to <html>
    document.body.classList.add('no-scroll'); // Apply to <body>
    // Wait 1000ms before adding the 'play' class to .doormat-animation
    setTimeout(function() {
        document.querySelector('.doormat-animation').classList.add('play');
        // Wait an additional 5000ms, then add the 'done' class to .doormat-animation.play
        setTimeout(function() {
            document.querySelector('.doormat-animation.play').classList.add('done');
            // Remove .no-scroll from <html> and <body> after animation ends
            document.documentElement.classList.remove('no-scroll');
            document.body.classList.remove('no-scroll');
            // Mark the animation as played in this session
            sessionStorage.setItem('animationPlayed', 'true');
        }, 5000);
    }, 1000); // Initial delay before adding .play
});
</script>{% render 'search_javascript' %}
<script>document.querySelector('.open-signup-trigger').addEventListener('click', () => {
  // Add the .open class to .open-signup-trigger
  const trigger = document.querySelector('.open-signup-trigger');
  trigger.classList.add('open');
  // Add the .open class to .newsletter-input-field-hidden
  const hiddenInputField = document.querySelector('.newsletter-input-field-hidden');
  hiddenInputField.classList.add('open');
  // Add the .open class to .newsletter-signup-btn
  const signupBtn = document.querySelector('.newsletter-signup-btn');
  signupBtn.classList.add('open');
  // Add the .open class to .newsletter-form-input after 0.5 seconds
  setTimeout(() => {
    const formInput = document.querySelector('.newsletter-form-input');
    formInput.classList.add('open');
  }, 500); // 500 milliseconds = 0.5 seconds
});
</script><script src="https://unpkg.com/@studio-freight/lenis@1.0.36/dist/lenis.min.js"></script><script>// LENIS SMOOTH SCROLL
let lenis;
if (Webflow.env("editor") === undefined) {
  lenis = new Lenis({
    lerp: 0.3,
    wheelMultiplier: 0.7,
    gestureOrientation: "vertical",
    normalizeWheel: false,
    smoothTouch: false
  });
  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);
}
$("[data-lenis-start]").on("click", function () {
  lenis.start();
});
$("[data-lenis-stop]").on("click", function () {
  lenis.stop();
});
$("[data-lenis-toggle]").on("click", function () {
  $(this).toggleClass("stop-scroll");
  if ($(this).hasClass("stop-scroll")) {
    lenis.stop();
  } else {
    lenis.start();
  }
});
</script><script>document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.slide-into-view');
    let options = {
      rootMargin: '0px 0px -10%', // Adjust this value to trigger the animation earlier
      threshold: 0.3 // This can also be adjusted based on how early you want the animation to start
    };
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          // Add a delay based on the index to stagger the animations
          setTimeout(() => {
            entry.target.style.opacity = 1;
            entry.target.style.transform = 'translateY(0)';
          }, index * 300); // Staggered delay
        }
      });
    }, options);
    items.forEach((item, index) => {
      observer.observe(item);
    });
  });
</script><script>document.addEventListener('cartupdated', function() {
    window.location.href = '/cart';
});
    </script><script>document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".nav-link-child-wrapper").forEach(wrapper => {
        let count = 1;
        wrapper.querySelectorAll(".nav-child-link-grid .nav_dropdown-link_child").forEach((element, index) => {
            if (element.textContent.trim().match(/^\d+$/)) {
                element.textContent = String(count).padStart(2, '0');
                count++;
            }
        });
    });
});
</script>